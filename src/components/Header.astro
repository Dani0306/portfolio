---
import { nav, site } from '../data/site';
import { htmlLang, langFromUrl, localize, switchPath, t } from '../i18n/ui';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';

const lang = langFromUrl(Astro.url);
const tr = t(lang);
const other = lang === 'en' ? 'es' : 'en';
const home = localize(lang, '/');
const isHome = Astro.url.pathname === home || Astro.url.pathname === home.replace(/\/$/, '');
const links = nav.map((item) => ({ label: tr.nav[item.key], href: `${home}${item.hash}` }));

const linkClass =
  'rounded-full px-3 py-2 text-sm font-medium text-muted transition-colors duration-700 ease-fluid hover:text-ink aria-[current=true]:text-ink';
const roundButton = 'grid size-10 place-items-center rounded-full text-ink transition-colors duration-700 ease-fluid hover:bg-ink/5';
---

<header class="site-header pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-6 md:justify-start md:px-16">
  <div
    class="pointer-events-auto flex w-max items-center gap-1 rounded-full border border-ink/10 bg-canvas/70 p-2 backdrop-blur-md"
  >
    <a href={home} class={roundButton} aria-label={`${site.name}, ${tr.home}`}>
      <Monogram class="h-5 w-auto" />
    </a>

    <nav aria-label={tr.mainNav} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((item) => (
            <li>
              <a href={item.href} class={linkClass} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      isHome && (
        <a href="#work" data-skip-intro class="rounded-full px-3 py-2 font-mono text-sm text-muted hover:text-ink">
          {tr.skipIntro}
        </a>
      )
    }

    <a
      href={switchPath(Astro.url, other)}
      hreflang={htmlLang[other]}
      lang={htmlLang[other]}
      aria-label={tr.langSwitch.name}
      data-lang-switch
      class="hidden rounded-full px-3 py-2 font-mono text-sm text-muted transition-colors duration-700 ease-fluid hover:text-ink md:block"
    >
      {tr.langSwitch.label}
    </a>

    <button
      type="button"
      data-command-open
      aria-label={tr.command.open}
      aria-keyshortcuts="Meta+K Control+K"
      class:list={[roundButton, 'hidden md:grid']}
    >
      <Icon name="command" class="size-4" />
    </button>

    <a
      href={`mailto:${site.email}`}
      class="rounded-full bg-accent px-3 py-2 text-sm font-semibold text-canvas transition-colors duration-700 ease-fluid hover:brightness-110 active:scale-[0.98]"
    >
      {tr.getInTouch}
    </a>

    <button type="button" popovertarget="site-menu" aria-label={tr.openMenu} class:list={[roundButton, 'md:hidden']}>
      <span class="relative block h-2 w-4" aria-hidden="true">
        <span class="absolute inset-x-0 top-0 h-px bg-current"></span>
        <span class="absolute inset-x-0 bottom-0 h-px bg-current"></span>
      </span>
    </button>
  </div>
</header>

<!-- Native popover: opens and closes without JavaScript. -->
<nav
  id="site-menu"
  popover
  aria-label={tr.mainNav}
  class="fixed inset-0 m-0 size-full max-h-none max-w-none border-0 bg-canvas/80 p-0 text-ink backdrop-blur-3xl md:hidden"
>
  <button
    type="button"
    popovertarget="site-menu"
    popovertargetaction="hide"
    aria-label={tr.closeMenu}
    data-menu-close
    class="absolute top-8 right-6 grid size-10 place-items-center rounded-full hover:bg-ink/5"
  >
    <span class="relative block h-2 w-4" aria-hidden="true">
      <span class="absolute inset-x-0 top-0 h-px bg-current"></span>
      <span class="absolute inset-x-0 bottom-0 h-px bg-current"></span>
    </span>
  </button>
  <ul class="flex h-full flex-col justify-center gap-6 px-6">
    {
      links.map((item, i) => (
        <li>
          <a href={item.href} data-menu-link class="text-4xl font-semibold tracking-tight" style={`transition-delay: ${100 + i * 50}ms`}>
            {item.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href={switchPath(Astro.url, other)}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        data-menu-link
        class="font-mono text-base text-muted"
        style={`transition-delay: ${100 + links.length * 50}ms`}
      >
        {tr.langSwitch.name}
      </a>
    </li>
  </ul>
</nav>

<script>
  // Close the menu after picking a section.
  const menu = document.getElementById('site-menu');
  menu?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => menu.hidePopover());
  });

  // Mark the section currently on screen in the navigation. Waits for DOMContentLoaded,
  // which fires after every module script, so the scroll world has moved its stop ids
  // onto their scroll markers by then.
  document.addEventListener('DOMContentLoaded', () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const sections = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((section): section is HTMLElement => section !== null);

    const onScreen = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target.id);
          else onScreen.delete(entry.target.id);
        }
        links.forEach((link) => link.setAttribute('aria-current', String(onScreen.has(link.hash.slice(1)))));
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>
