---
/**
 * Not found, in both languages: Vercel serves this for any unknown path, and
 * the visitor's language is not known yet. Styled like a scroll world stop.
 */
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { world } from '../config/world';
import { ui } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

const still = world.stops[0];
const { en, es } = { en: ui.en.notFound, es: ui.es.notFound };

const primary =
  'inline-flex items-center gap-2 rounded-full bg-accent px-3 py-2 text-base font-semibold text-canvas transition duration-700 ease-fluid hover:brightness-110 active:scale-[0.98]';
const secondary =
  'inline-flex items-center gap-2 rounded-full border border-ink/20 px-3 py-2 text-base font-semibold text-ink transition duration-700 ease-fluid hover:border-ink/40 hover:bg-ink/5 active:scale-[0.98]';
---

<Layout title={`${en.title} | Daniel Colorado`} noindex>
  <Header />
  <main id="main" tabindex="-1" class="outline-none">
    <section class="relative flex min-h-svh items-end px-4 pt-32 pb-16 min-[861px]:items-center min-[861px]:px-16">
      <img
        src={still.still}
        srcset={`${still.stillMobile} 1280w, ${still.still} 1920w`}
        sizes="100vw"
        width="1920"
        height="1080"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 size-full object-cover"
        style={`object-position: ${still.focusX}% 50%`}
      />
      <div class="world-scrim absolute inset-0" aria-hidden="true"></div>

      <div class="relative w-full max-w-xl">
        <figure class="border border-ink/10 bg-canvas/70 font-mono text-sm backdrop-blur-md">
          <figcaption class="border-b border-ink/10 px-3 py-2 text-xs text-muted">zsh</figcaption>
          <div class="space-y-1 px-3 py-3 leading-6">
            <p class="text-muted">$ cd <span data-missing-path class="text-ink">/this-page</span></p>
            <p class="text-ink">
              cd: <span class="text-accent">{en.error}</span>
            </p>
            <p class="text-muted" lang="es-CO">cd: {es.error}<span class="caret" aria-hidden="true"></span></p>
          </div>
        </figure>

        <h1 class="mt-10 text-5xl font-semibold tracking-tight max-[860px]:text-4xl">404</h1>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="text-xl font-semibold text-ink">{en.title}</p>
            <p class="mt-2 text-base text-ink/90">{en.body}</p>
            <a href="/" class:list={[primary, 'mt-6']}>
              <Icon name="arrowLeft" />
              {en.home}
            </a>
          </div>
          <div lang="es-CO">
            <p class="text-xl font-semibold text-ink">{es.title}</p>
            <p class="mt-2 text-base text-ink/90">{es.body}</p>
            <a href="/es/" class:list={[secondary, 'mt-6']}>
              <Icon name="arrowLeft" />
              {es.home}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Echo the path the visitor asked for in the fake terminal.
  const path = document.querySelector('[data-missing-path]');
  if (path) path.textContent = decodeURIComponent(window.location.pathname);
</script>
