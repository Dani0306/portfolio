---
import { Font } from 'astro:assets';

import CommandMenu from '../components/CommandMenu.astro';
import { siteCopy } from '../data/site';
import { htmlLang, langFromUrl, langs, ogLocale, switchPath, t } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Share card, relative to the site root. */
  image?: string;
  type?: 'website' | 'article';
  /** Leave out of search results (the 404 page). */
  noindex?: boolean;
}

const lang = langFromUrl(Astro.url);
const copy = siteCopy[lang];
const tr = t(lang);
const {
  title = copy.title,
  description = copy.description,
  image = lang === 'es' ? '/og/home-es.png' : '/og/home.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const absolute = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const canonical = absolute(Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Lets CSS hide the no JavaScript version of the scroll world before the engine mounts. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0f12" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => (
            <link rel="alternate" hreflang={htmlLang[l]} href={absolute(switchPath(Astro.url, l))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(switchPath(Astro.url, 'en'))} />
        </>
      )
    }

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Daniel Colorado" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={absolute(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(image)} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body class="bg-canvas text-ink">
    <a
      href="#main"
      class="sr-only fixed top-4 left-4 z-[60] rounded-full bg-accent px-3 py-2 text-sm font-semibold text-canvas focus:not-sr-only"
    >
      {tr.skipToContent}
    </a>
    <slot />
    <CommandMenu />
    <script>
      import '../scripts/copy-email';
      import '../scripts/local-time';
    </script>
  </body>
</html>
